# Copier en .env (jamais versionné).
LOG_LEVEL=INFO

# Mot de passe de la base PostgreSQL (lu par compose.yaml et par l'API via DATABASE_URL).
POSTGRES_PASSWORD=change-me

# URL du serveur MLflow pour les clients (train, registre). Sur la VM : http://<ip-vm>:5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# PYTHON_IMAGE=python:3.12-slim
# TAG=dev

# S6 : mot de passe du compte admin de Grafana (compose.monitoring.yaml)
GRAFANA_ADMIN_PASSWORD=change-me
# S6 : à décommenter une fois les fichiers du TP6 récupérés, pour que toute commande
# docker compose (release.sh compris) lance les trois fichiers ensemble
# COMPOSE_FILE=compose.yaml:compose.mlflow.yaml:compose.monitoring.yaml
