# Copier en .env (jamais versionné).
LOG_LEVEL=INFO

# Mot de passe de la base PostgreSQL (lu par compose.yaml et par l'API via DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Mot de passe de la base du serveur MLflow (lu par compose.mlflow.yaml).
# Éviter les caractères spéciaux : il est inséré tel quel dans une URL.
MLFLOW_DB_PASSWORD=change-me
# URL du serveur MLflow pour les clients (train, registre). Sur la VM : http://<ip-vm>:5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
